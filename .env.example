FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# Database Configuration (sqlite or mysql)
DB_TYPE=sqlite
SQLITE_DB=college.db

# MySQL Configuration (Optional - only needed if DB_TYPE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=college

FRONTEND_ORIGIN=http://localhost,http://127.0.0.1
